#!/usr/bin/env bash
# sign-release FILE: sign FILE with the release key in $ROKAST_SIGNING_KEY (the private key text; repo secret of the
# same name) -> FILE.sig, then check the signature against config/release-signers, the public keys every install
# ships and `rokast update` verifies with. Fails if the key is missing or is not listed there.
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
file="${1:?usage: sign-release FILE}"
signers="${ROKAST_SIGNERS:-$root/config/release-signers}"
[ -n "${ROKAST_SIGNING_KEY:-}" ] || { echo "sign-release: ROKAST_SIGNING_KEY is empty (repo secret missing?)" >&2; exit 1; }
k="$(mktemp -d)"; trap 'rm -rf "$k"' EXIT
printf '%s\n' "$ROKAST_SIGNING_KEY" > "$k/key"; chmod 600 "$k/key"
rm -f "$file.sig"
ssh-keygen -q -Y sign -f "$k/key" -n rokast-release "$file"
ssh-keygen -q -Y verify -f "$signers" -I rokast-release -n rokast-release -s "$file.sig" < "$file" >/dev/null \
    || { echo "sign-release: the key is not in $signers" >&2; exit 1; }
echo "signed $file.sig"
