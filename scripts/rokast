#!/usr/bin/env bash
# rokast {list [--json]|start [name]|doctor|ui|...}  -- native Miracast to a Roku TV, no app on the TV.
# Runs the Rust rokast (target/release/rokast) when it is built, else the Python one (src/miracast/cli.py).
# ROKAST_PY=1 forces Python (the escape hatch during the Rust port, docs/plan-rust.md).
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
bin="$root/target/release/rokast"
if [ "${ROKAST_PY:-0}" = 0 ] && [ -x "$bin" ]; then
    # a git clone with Rust sources newer than the binary: a stale build would hide the change, so use Python
    if [ -d "$root/.git" ] && [ -n "$(find "$root/src/rokast" "$root/src/rokast-core/src" "$root/Cargo.lock" \
            -newer "$bin" -print -quit 2>/dev/null)" ]; then
        echo "rokast: $bin is older than the source; using Python (cargo build --release -p rokast)" >&2
    else
        ROKAST_ROOT="$root" exec "$bin" "$@"
    fi
fi
exec python3 -I "$root/src/miracast/cli.py" "$@"
