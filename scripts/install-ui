#!/usr/bin/env bash
# Build the rokast desktop UI and add it to the applications menu (per user, no root).
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
bin="$root/ui/target/release/rokast-ui"
if command -v cargo >/dev/null; then
  cargo build --release --manifest-path "$root/ui/Cargo.toml"
elif [ -x "$bin" ]; then
  echo "cargo not found: using the prebuilt $bin (release tarball)"
else
  echo "need cargo (Rust) to build the UI, or a release tarball that includes ui/target/release/rokast-ui" >&2; exit 1
fi
apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
mkdir -p "$apps"
sed "s|@BIN@|$bin|" "$root/assets/rokast.desktop" > "$apps/io.github.papacasper.rokast.desktop"
install -Dm644 "$root/assets/rokast.svg" "${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps/io.github.papacasper.rokast.svg"
if command -v update-desktop-database >/dev/null; then update-desktop-database "$apps" || true; fi
echo "installed: $apps/io.github.papacasper.rokast.desktop (run: rokast ui, or 'rokast' in the app menu)"
