#!/usr/bin/env bash
# scripts/release X.Y.Z -- cut a release: checks, version bump, commit, tag vX.Y.Z, push.
# The tag push triggers .github/workflows/release.yml, which builds and publishes the GitHub Release.
# Write the CHANGELOG.md "## X.Y.Z" section first. Runbook: playbooks/release.md
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$root"
v="${1:-}"
die() { echo "release: $*" >&2; exit 1; }

[[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "usage: scripts/release X.Y.Z"
[ "$(git branch --show-current)" = main ] || die "not on main"
[ -z "$(git status --porcelain)" ] || die "working tree not clean"
git fetch -q origin main
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || die "main is not in sync with origin/main"
! git rev-parse -q --verify "refs/tags/v$v" >/dev/null || die "tag v$v already exists"
grep -qx "## $v" CHANGELOG.md || die "CHANGELOG.md has no '## $v' section"

python3 -I -m unittest discover -s tests
(cd ui && cargo test --release --locked)

echo "$v" > VERSION
sed -i "0,/^version = \".*\"/s//version = \"$v\"/" ui/Cargo.toml
(cd ui && cargo update -q --workspace)          # only rokast-ui's own entry in Cargo.lock
if [ -n "$(git status --porcelain)" ]; then
  git add VERSION ui/Cargo.toml ui/Cargo.lock
  git commit -q -m "Release v$v"
fi
git tag -a "v$v" -m "rokast $v"
git push -q origin main "v$v"
echo "pushed v$v; follow the build: gh run watch \$(gh run list -w release -L1 --json databaseId -q '.[0].databaseId')"
