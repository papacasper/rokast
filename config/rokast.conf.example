# Copy to ~/.config/rokast/rokast.conf (`rokast config` prints the path in use).
TARGET=                     # exact TV name from `scripts/rokast list`, e.g. 43" onn. Roku TV
RES=1080p30,720p60,720p30   # preference order; falls back to whatever the TV supports
BITRATE=8M
ENCODER=auto                # auto = first that works of h264_nvenc, h264_vaapi, libx264, libopenh264
AUDIO=tv                    # tv = sound only on the TV, both = TV and this computer, off, app:<name>, device:<output> (`rokast audio` lists them)
CAPTURE=auto                # auto = wayland (screen-sharing portal + PipeWire) in a Wayland session, else x11
FIT=bars                    # bars = picture scaled in (black bars if the shapes differ), match = screen takes the TV's size while mirroring (X11)
FPS=tv                      # tv = the rate the TV asks for (30 at HD), 60 = smoother motion (laptop at 60 Hz while mirroring on X11)
SCREEN=mirror               # mirror = the TV shows this screen, extend = the TV is a second screen (X11)
EXTEND_SIDE=right           # where the second screen sits: right, left, above, below
DISPLAY=:0
NAME=                       # name the TV shows for this computer; empty = its hostname (`hostnamectl --pretty`, else `hostname`)
