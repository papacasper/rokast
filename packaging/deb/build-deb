#!/usr/bin/env bash
# packaging/deb/build-deb <outdir>
# Build rokast_<VERSION>_amd64.deb (same /usr/lib/rokast layout as the AUR package, via packaging/stage).
# Needs: ui/target/release/rokast-ui already built, and the supplicant build deps
# (build-essential pkg-config libnl-3-dev libnl-genl-3-dev libssl-dev curl). Run by the ci and release workflows,
# on Ubuntu 22.04 so the result runs on 22.04+ / Debian 12+. Check it with tests/test_pkg_deb.sh.
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
out="$(mkdir -p "${1:?usage: packaging/deb/build-deb <outdir>}" && cd "$1" && pwd)"
v="$(cat "$root/VERSION")"
t="$(mktemp -d)"; trap 'rm -rf "$t"' EXIT
sup="${ROKAST_PREBUILT_SUPPLICANT:-$t/supplicant}"   # tests reuse one build (wpa_supplicant + patch.sha256)
[ -n "${ROKAST_PREBUILT_SUPPLICANT:-}" ] || "$root/packaging/supplicant" "$sup"

d="$t/rokast_${v}_amd64"
"$root/packaging/stage" "$d" "$sup"
install -Dm644 "$root/LICENSE" "$d/usr/share/doc/rokast/copyright"
mkdir -p "$d/DEBIAN"
cat > "$d/DEBIAN/control" <<EOF
Package: rokast
Version: $v
Architecture: amd64
Maintainer: papacasper <chj1axr0@gmail.com>
Installed-Size: $(du -sk "$d/usr" | cut -f1)
Depends: python3 (>= 3.10), ffmpeg, iw, dhcpcd5 | dhcpcd-base | dhcpcd, wpasupplicant, sudo, iproute2, openssh-client,
 libnl-3-200, libnl-genl-3-200, libssl3 | libssl3t64, libgtk-4-1 (>= 4.6), libc6 (>= 2.35)
Recommends: x11-xserver-utils, pulseaudio-utils
Suggests: gstreamer1.0-tools, gstreamer1.0-plugins-base, gstreamer1.0-pipewire, python3-gi, xdg-desktop-portal
Section: video
Priority: optional
Homepage: https://github.com/papacasper/rokast
Description: mirror your Linux screen to a Roku TV over native Miracast
 rokast joins the TV's Wi-Fi Direct group with its own patched wpa_supplicant
 (in /usr/lib/rokast) and streams the screen with ffmpeg. Nothing is installed
 on the TV, and your normal Wi-Fi connection stays up. Includes a GTK 4
 desktop app with a tray icon; run "rokast doctor" to check your setup.
EOF
dpkg-deb --root-owner-group -Zxz --build "$d" "$out/rokast_${v}_amd64.deb" >/dev/null
echo "$out/rokast_${v}_amd64.deb"
