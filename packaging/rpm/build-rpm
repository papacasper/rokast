#!/usr/bin/env bash
# packaging/rpm/build-rpm <outdir>
# Build rokast-<VERSION>-1.x86_64.rpm for Fedora: the same /usr/lib/rokast tree as the .deb (packaging/stage), with
# library Requires generated by rpmbuild from the binaries. Built on Ubuntu 22.04 like the .deb (needs `rpm`), so the
# binaries need only glibc 2.35 / GTK 4.6, which every supported Fedora has. Same build deps as build-deb.
# Fedora's ffmpeg-free has no libx264: auto-detect then uses libopenh264 (capture.ENCODERS), and RPM Fusion's ffmpeg
# also satisfies the Requires. Check it with tests/test_pkg_rpm.sh.
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
out="$(mkdir -p "${1:?usage: packaging/rpm/build-rpm <outdir>}" && cd "$1" && pwd)"
v="$(cat "$root/VERSION")"
t="$(mktemp -d)"; trap 'rm -rf "$t"' EXIT
sup="${ROKAST_PREBUILT_SUPPLICANT:-$t/supplicant}"   # tests reuse one build (wpa_supplicant + patch.sha256)
[ -n "${ROKAST_PREBUILT_SUPPLICANT:-}" ] || "$root/packaging/supplicant" "$sup"
"$root/packaging/stage" "$t/tree" "$sup" >/dev/null
cat > "$t/rokast.spec" <<EOF
Name:           rokast
Version:        $v
Release:        1
Summary:        Mirror your Linux screen to a Roku TV over native Miracast
License:        MIT
URL:            https://github.com/papacasper/rokast
BuildArch:      x86_64
Requires:       (ffmpeg-free or ffmpeg), iw, dhcpcd, wpa_supplicant, sudo, iproute, openssh-clients
Recommends:     xrandr, pulseaudio-utils
Suggests:       gstreamer1, gstreamer1-plugins-base, pipewire-gstreamer, xdg-desktop-portal
# prebuilt tree: no debuginfo split, no stripping passes (the binaries are built and stripped by cargo)
%global debug_package %{nil}
%global __os_install_post %{nil}
%global _build_id_links none

%description
rokast joins the TV's Wi-Fi Direct group with its own patched wpa_supplicant
(in /usr/lib/rokast) and streams the screen with ffmpeg. Nothing is installed
on the TV, and your normal Wi-Fi connection stays up. Includes a GTK 4
desktop app with a tray icon; run "rokast doctor" to check your setup.

%install
cp -a $t/tree/. %{buildroot}/

%files
/usr/lib/rokast
/usr/bin/rokast
/usr/share/applications/io.github.papacasper.rokast.desktop
/usr/share/icons/hicolor/scalable/apps/io.github.papacasper.rokast.svg
%license /usr/share/licenses/rokast/LICENSE
EOF
rpmbuild -bb --quiet --define "_topdir $t/rpmbuild" --define "_dbpath $t/rpmdb" "$t/rokast.spec" >/dev/null
cp "$t/rpmbuild/RPMS/x86_64/rokast-$v-1.x86_64.rpm" "$out/"
echo "$out/rokast-$v-1.x86_64.rpm"
